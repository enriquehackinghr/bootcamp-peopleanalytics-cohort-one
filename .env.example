# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Class 4 session signing (min 16 chars). Required in production.
SESSION_SECRET=

# Wizard (server-side only — never expose to the client)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Adversarial AI auditor (Claude — red-teams the wizard's reports)
ADVERSARIAL_AI_LLM_API_KEY=
ADVERSARIAL_AI_MODEL=claude-opus-4-5
ADVERSARIAL_AI_FALLBACK_MODEL=claude-sonnet-4-5
# Shared secret required for cron-triggered runs. Set the same value on both
# the web service and the Render cron job.
ADVERSARIAL_CRON_SECRET=

# Resend (server-side only — wire transactional email later)
RESEND_API_KEY=

# Optional: label recorded in data_loads.loaded_by
INGEST_ACTOR=admin
